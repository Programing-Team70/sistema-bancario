# Variables de entorno para Railway (authentication-service)
# Configúralas en: Railway → tu servicio → Variables
# NO subas valores reales a git.

# --- Base de datos Supabase (PostgreSQL) ---
# Formato EF Core / Npgsql:
ConnectionStrings__DefaultConnection=Host=db.xxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=TU_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# --- JWT (debe coincidir con core_bank_service) ---
JwtSettings__SecretKey=$ecretKeyForKingProgramingTeam70
JwtSettings__Issuer=BancoKing
JwtSettings__Audience=BancoKing
JwtSettings__ExpirationMinutes=60

# --- Frontend (URL de Firebase Hosting) ---
AppSettings__FrontendUrl=https://tu-proyecto.web.app

# --- CORS (misma URL del frontend) ---
Security__AllowedOrigins__0=https://tu-proyecto.web.app
Security__AllowedOrigins__1=https://tu-proyecto.firebaseapp.com

# --- Email (Brevo recomendado en cloud) ---
Email__Provider=Brevo
Brevo__ApiKey=xkeysib-tu-api-key
Brevo__FromEmail=jef3rson123@gmail.com
Brevo__FromName=Banco King

# --- Puerto (Railway lo inyecta; el Dockerfile usa 8080) ---
ASPNETCORE_URLS=http://+:8080
