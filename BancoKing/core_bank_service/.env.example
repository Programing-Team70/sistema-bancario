# Core Bank Service — variables para Vercel o local
PORT=3001

# Opción A: URI completa de Supabase (recomendado en Vercel)
DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres

# Opción B: variables separadas
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_password_supabase
DB_SSL=true

# JWT (debe coincidir con authentication-service)
SECRET_KEY=$ecretKeyForKingProgramingTeam70
JWT_ISSUER=BancoKing
JWT_AUDIENCE=BancoKing

# URL del auth en Railway (sin barra final)
AUTH_SERVICE_URL=https://tu-auth.up.railway.app/api/v1

TZ=America/Guatemala
